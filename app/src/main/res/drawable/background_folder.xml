<?xml version="1.0" encoding="utf-8"?>
<selector
    xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true" android:drawable="@drawable/giant_selected" />

    <item android:state_drag_hovered="true">
        <shape>
            <solid android:color="?attr/colorTertiaryContainer" />

            <corners android:radius="16dp" />
        </shape>
    </item>

    <item android:state_drag_can_accept="true">
        <shape>
            <solid android:color="?attr/colorSecondaryContainer" />

            <corners android:radius="16dp" />
        </shape>
    </item>

    <item android:drawable="@drawable/giant_row" />
</selector>
