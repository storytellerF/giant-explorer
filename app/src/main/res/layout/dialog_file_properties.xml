<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="20dp"
    android:background="?attr/colorSurface">
    <ScrollView android:layout_width="match_parent" android:layout_height="wrap_content">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <TextView
                android:id="@+id/name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/giant_field"
                android:padding="10dp"
                tools:text="hello.txt"
                android:textAppearance="@style/TextAppearance.Giant.Subtitle" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/full_path"
                style="@style/Widget.Giant.Button.Text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="start"
                android:padding="10dp"
                android:textAllCaps="false"
                android:textColor="?attr/colorPrimary"
                tools:text="/sdcard/"
                android:minHeight="48dp" />

            <TextView
                android:id="@+id/accessedTime"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/giant_field"
                android:padding="5dp"
                tools:text="2022"
                android:textAppearance="@style/TextAppearance.Giant.Body" />

            <TextView
                android:id="@+id/modifiedTime"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/giant_field"
                android:padding="5dp"
                tools:text="2022"
                android:textAppearance="@style/TextAppearance.Giant.Body" />

            <TextView
                android:id="@+id/createdTime"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/giant_field"
                android:padding="5dp"
                tools:text="2022"
                android:textAppearance="@style/TextAppearance.Giant.Body" />

            <TextView
                android:id="@+id/video_info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/giant_field"
                android:padding="10dp"
                android:textAppearance="@style/TextAppearance.Giant.Body" />

            <TextView
                android:id="@+id/audio_info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/giant_field"
                android:padding="10dp"
                android:textAppearance="@style/TextAppearance.Giant.Body" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>
