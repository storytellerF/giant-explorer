<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:background="?attr/colorSurface">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/sort_and_filter"
            android:textSize="20sp"
            android:textStyle="bold"
            android:paddingBottom="16dp"
            android:textAppearance="@style/TextAppearance.Giant.Title" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/sort_by"
            android:textSize="16sp"
            android:textStyle="bold"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:textAppearance="@style/TextAppearance.Giant.Body" />

        <RadioGroup
            android:id="@+id/sort_type_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <RadioButton
                android:id="@+id/sort_by_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/sort_by_name"
                android:padding="8dp"
                android:minHeight="48dp" />

            <RadioButton
                android:id="@+id/sort_by_size"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/sort_by_size"
                android:padding="8dp"
                android:minHeight="48dp" />

            <RadioButton
                android:id="@+id/sort_by_time"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/sort_by_time"
                android:padding="8dp"
                android:minHeight="48dp" />
        </RadioGroup>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/sort_direction"
            android:textSize="16sp"
            android:textStyle="bold"
            android:paddingTop="16dp"
            android:paddingBottom="8dp"
            android:textAppearance="@style/TextAppearance.Giant.Body" />

        <RadioGroup
            android:id="@+id/sort_direction_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <RadioButton
                android:id="@+id/sort_ascending"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/sort_ascending"
                android:padding="8dp"
                android:minHeight="48dp" />

            <RadioButton
                android:id="@+id/sort_descending"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/sort_descending"
                android:padding="8dp"
                android:minHeight="48dp" />
        </RadioGroup>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/filter_options"
            android:textSize="16sp"
            android:textStyle="bold"
            android:paddingTop="16dp"
            android:paddingBottom="8dp"
            android:textAppearance="@style/TextAppearance.Giant.Body" />

        <CheckBox
            android:id="@+id/filter_hidden_files"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/filter_hidden_file"
            android:padding="8dp"
            android:minHeight="48dp" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
