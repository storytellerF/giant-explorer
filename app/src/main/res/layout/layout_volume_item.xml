<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/giant_row"
    android:padding="16dp"
    android:layout_marginBottom="8dp"
    android:minHeight="72dp">
    <TextView
        android:id="@+id/volume_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        tools:text="内部存储"
        android:textAppearance="@style/TextAppearance.Giant.Subtitle" />

    <TextView
        android:id="@+id/volume_space"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:gravity="center_vertical"
        tools:text="已用：32 GB"
        android:textAppearance="@style/TextAppearance.Giant.Body" />

    <TextView
        android:id="@+id/volume_free"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:gravity="center_vertical"
        android:textColor="?attr/colorPrimary"
        tools:text="可用：96 GB"
        android:textAppearance="@style/TextAppearance.Giant.Body" />

    <TextView
        android:id="@+id/volume_total"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:gravity="center_vertical"
        tools:text="总容量：128 GB"
        android:textAppearance="@style/TextAppearance.Giant.Body" />

    <TextView
        android:id="@+id/capacity_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginVertical="12dp"
        android:text="@string/storage_capacity_unavailable"
        android:textAppearance="@style/TextAppearance.Giant.Body" />

    <LinearLayout
        android:id="@+id/info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:id="@+id/volume_state"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            tools:text="可用"
            android:textAppearance="@style/TextAppearance.Giant.Caption" />
    </LinearLayout>
</LinearLayout>
