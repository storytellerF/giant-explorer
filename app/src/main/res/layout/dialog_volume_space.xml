<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/storage_heading"
            android:textAppearance="@style/TextAppearance.Giant.DialogTitle"
            android:layout_marginBottom="16dp" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="@string/storage_capacity_help"
            android:textAppearance="@style/TextAppearance.Giant.Caption" />
        <TextView
            android:id="@+id/storage_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="@string/storage_loading"
            android:textAppearance="@style/TextAppearance.Giant.Body" />
        <LinearLayout
            android:id="@+id/space_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="0dp"
            android:paddingVertical="0dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/manage_permission"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/manage_permission"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/space_list"
            style="@style/Widget.Giant.Button"
            android:minHeight="48dp"
            android:textAllCaps="false" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/dismiss_dialog"
            style="@style/Widget.Giant.Button.Text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/dismiss_overlay" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
