<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.core.widget.NestedScrollView
        android:id="@+id/task_content"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="false"
        android:scrollbars="vertical"
        app:layout_constraintHeight_default="wrap"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/task_actions">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp"
            android:paddingBottom="8dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <ImageView
                    android:id="@+id/operation_icon"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginEnd="16dp"
                    android:background="@drawable/giant_icon_background"
                    android:padding="12dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_overlay_copy" />
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:id="@+id/task_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/file_task_title"
                        android:textAppearance="@style/TextAppearance.Giant.DialogTitle"
                        tools:text="复制文件" />
                    <TextView
                        android:id="@+id/task_status"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:accessibilityLiveRegion="polite"
                        android:text="@string/file_task_preparing"
                        android:textAppearance="@style/TextAppearance.Giant.Label" />
                </LinearLayout>
            </LinearLayout>
            <TextView
                android:id="@+id/done_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:textAppearance="@style/TextAppearance.Giant.Body"
                tools:text="正在计算所选文件的数量与大小。" />
            <TextView
                android:id="@+id/task_subject"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:textAppearance="@style/TextAppearance.Giant.Subtitle"
                android:textIsSelectable="true"
                tools:text="旅行照片.zip" />
            <LinearLayout
                android:id="@+id/destination_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/target_folder"
                    android:textAppearance="@style/TextAppearance.Giant.Caption" />
                <TextView
                    android:id="@+id/task_destination"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textAppearance="@style/TextAppearance.Giant.Body"
                    android:textIsSelectable="true"
                    tools:text="/storage/emulated/0/Download" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/task_progress_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="vertical">
                <ProgressBar
                    android:id="@+id/progressBar"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="8dp"
                    android:indeterminate="true"
                    android:max="100"
                    tools:progress="45" />
                <TextView
                    android:id="@+id/task_progress_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="end"
                    android:textAppearance="@style/TextAppearance.Giant.Caption"
                    tools:text="45%" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/task_summary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/giant_row"
                android:orientation="vertical"
                android:padding="16dp">
                <TextView
                    android:id="@+id/task_counts"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.Giant.Subtitle"
                    tools:text="已处理 3 / 8 项" />
                <TextView
                    android:id="@+id/task_size"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textAppearance="@style/TextAppearance.Giant.Body"
                    tools:text="已处理 24 MB / 64 MB" />
                <TextView
                    android:id="@+id/task_breakdown"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textAppearance="@style/TextAppearance.Giant.Caption"
                    tools:text="共 6 个文件、2 个文件夹" />
            </LinearLayout>
            <TextView
                android:id="@+id/textView_state"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textAppearance="@style/TextAppearance.Giant.Caption"
                tools:text="正在处理：照片.jpg" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/task_details_toggle"
                style="@style/Widget.Giant.Button.Text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/file_task_show_details" />
            <TextView
                android:id="@+id/textView_detail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textAppearance="@style/TextAppearance.Giant.Caption"
                android:textIsSelectable="true"
                android:visibility="gone"
                tools:text="操作详情" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <LinearLayout
        android:id="@+id/task_actions"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="8dp"
        android:paddingBottom="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <com.google.android.material.button.MaterialButton
            android:id="@+id/cancel_operation"
            style="@style/Widget.Giant.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="0dp"
            android:text="@string/file_task_cancel" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/close_when_done"
            style="@style/Widget.Giant.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/file_task_background" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
